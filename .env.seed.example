# Dùng để chạy `npm run seed` (tạo tài khoản mẫu). Lấy ở Supabase Dashboard > Project Settings > API.
# SUPABASE_SERVICE_ROLE_KEY có toàn quyền, bỏ qua RLS — TUYỆT ĐỐI không commit, không dùng ở frontend.
# Copy file này thành .env.seed rồi điền giá trị thật trước khi chạy seed.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
